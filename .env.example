# Label Bros backend settings. Copy to .env.local for local work, or paste each one into the
# host's environment variables (Vercel: Project > Settings > Environment Variables;
# cPanel: Setup Node.js App > Environment variables). Step-by-step guide: reference/BACKEND.md
# Never commit the real values.

# --- Site
NEXT_PUBLIC_SITE_URL=https://labelbros.ca

# --- Database (Postgres). Neon free tier works on both Vercel and cPanel.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
# DATABASE_POOL_MAX=5
# DATABASE_IDLE_SECONDS=300   (keep connections open; reconnecting is the slow part)
# DATABASE_PREPARE=false      (only for a pooler without prepared statements; Neon has them)

# --- Stripe (dashboard.stripe.com > Developers > API keys / Webhooks)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Local development: pnpm stripe:listen saves the CLI signing secret automatically.
# Keep that terminal running. Use a separate Dashboard endpoint secret in production.
# STRIPE_WEBHOOK_SECRET_SOURCE=cli
# Shipping Rates made in Stripe (Product catalogue > Shipping rates):
#   CAD rate for Canadian orders under $100 CAD (over that, shipping in Canada is free)
# STRIPE_SHIPPING_RATE_ID=shr_...
#   USD rate for every order outside Canada
# STRIPE_SHIPPING_RATE_ID_USD=shr_...
# true once Stripe Tax is set up with your GST/HST registration
# STRIPE_AUTOMATIC_TAX=true
# Where USD orders ship (default: every country Stripe ships to, except Canada)
# SHIP_COUNTRIES_USD=US,GB,AU

# --- Email (any SMTP mailbox: the cPanel/GoDaddy inbox, Google Workspace, Resend, Postmark...)
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_USER=hello@labelbros.ca
SMTP_PASS=
MAIL_FROM=Label Bros <hello@labelbros.ca>
SHOP_INBOX=orders@labelbros.ca

# --- Admin (/admin). Make both with: pnpm admin:password
ADMIN_PASSWORD_HASH=scrypt:32768:8:1:...:...
SESSION_SECRET=
# SHOP_TIMEZONE=America/Vancouver

# --- Uploads: the largest artwork file sent with an order, in MB (Vercel's limit is 4.5)
# MAX_UPLOAD_MB=4
