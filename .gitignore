# Dependencies: reinstalled with `pnpm install`.
node_modules/
.pnpm-store/

# Build output and caches: regenerated by `next dev`, `next build` and `tsc`.
.next/
out/
build/
*.tsbuildinfo

# Secrets: never commit real keys (the example file lists the names only).
.env*
!.env.example
*.pem

# Hosting and tooling
.vercel/
coverage/
test-results/
playwright-report/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS and editor junk
.DS_Store
Thumbs.db
*.swp
